generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// The setting a piece is built for. Values were renamed from the original
/// home-furniture set (living room, bedroom, …) to President's actual
/// market: office, industrial, and hospital furniture. Enum positions are
/// preserved to match the DB after the ALTER TYPE ... RENAME VALUE migration.
enum RoomType {
  RECEPTION
  HEALTHCARE
  CONFERENCE
  OFFICE
  INDUSTRIAL
  WORKSPACE
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED_WON
  CLOSED_LOST
}

enum IssueType {
  BUG
  FEATURE
  CHANGE
  QUESTION
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  SSLCOMMERZ
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model AdminUser {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  stockReceipts StockReceipt[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([roleId])
}

/// A named, admin-manageable set of permissions. Seeded with a protected
/// "Administrator" role (isProtected = true) that always has every
/// permission and can't be edited/deleted, so the panel can't be
/// permission-locked-out.
model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  isProtected Boolean     @default(false)
  /// string[] of "module.action" permission keys — see src/lib/permissions.ts
  permissions Json
  users       AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  slug       String    @unique
  /// Short letters code used in generated product codes (e.g. "SC" for
  /// Shovel Chair) — admin-editable, uniqueness enforced in the app layer
  /// (not a DB constraint) since a migration can't safely assume every
  /// existing category name yields a unique fallback code.
  shortCode  String    @default("")
  /// Per-category running counter for {SEQ} in the product code pattern —
  /// incremented atomically (`UPDATE ... SET lastSeq = lastSeq + 1`) so
  /// concurrent product creation in the same category can't reuse a
  /// sequence number. See src/lib/product-code.ts.
  lastSeq    Int       @default(0)
  /// Whether this category gets a tile in the homepage category section —
  /// lets the storefront stay curated even with 100+ categories. Defaults
  /// to true so every existing category keeps showing until an admin
  /// deliberately curates the list.
  showOnHome Boolean   @default(true)
  /// Homepage tile order (ascending) — reordered via drag-and-drop or the
  /// keyboard-accessible Up/Down buttons on /admin/categories.
  order      Int       @default(0)
  /// Placeholder image shown on the homepage category tile. A pasted URL,
  /// not an upload widget — same pattern as the other admin-pasted image
  /// links in Settings (brandIconUrl etc. are the exception with a real
  /// uploader; this one deliberately isn't, to keep this change small).
  imageUrl   String?
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Admin-manageable material types (was a fixed enum) — lets the catalog
/// add/rename a material without a code change. `nameBn` is optional so
/// the storefront can still show a Bangla name where one's been set,
/// falling back to `name` otherwise.
model Material {
  id            String    @id @default(cuid())
  name          String    @unique
  nameBn        String?
  /// Products whose single required "primary" material this is.
  products      Product[] @relation("PrimaryMaterial")
  /// Products that also list this as an additional material (e.g. a chair
  /// whose primary material is Steel but also has a Leather seat) — see
  /// Product.materials.
  additionalFor Product[] @relation("AdditionalMaterials")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  /// Shown everywhere the product appears. Auto-generated from the pattern
  /// in Settings (see src/lib/product-code.ts) unless the admin types a
  /// custom one — either way this column is the real uniqueness guard.
  code              String?            @unique
  description       String             @db.Text
  price             Decimal            @db.Decimal(10, 2)
  compareAtPrice    Decimal?           @db.Decimal(10, 2)
  material          Material           @relation("PrimaryMaterial", fields: [materialId], references: [id])
  materialId        String
  /// Additional materials beyond the required primary one (e.g. a chair
  /// whose body is Steel but whose seat is Leather) — optional, can be
  /// empty. The storefront/spec table shows primary + these together.
  materials         Material[]         @relation("AdditionalMaterials")
  room              RoomType
  color             String?
  dimensions        String?
  deliveryEstimate  String?
  stockStatus       StockStatus        @default(IN_STOCK)
  stockQty          Int                @default(0)
  /// Below this quantity, the admin form suggests (but doesn't force)
  /// switching stockStatus to LOW_STOCK — see adjustStock in
  /// src/lib/actions/products.ts for where this is applied automatically.
  reorderLevel      Int                @default(5)
  featured          Boolean            @default(false)
  /// Manually curated by the admin (a checkbox on the product form) — the
  /// homepage Trending section shows these, not just recently-added
  /// products. See docs/TODO-FEATURE-REQUESTS.md history for why this is
  /// separate from `featured`.
  isTrending        Boolean            @default(false)
  viewCount         Int                @default(0)
  images            ProductImage[]
  category          Category           @relation(fields: [categoryId], references: [id])
  categoryId        String
  leadItems         LeadItem[]
  orderItems        OrderItem[]
  stockReceiptItems StockReceiptItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([categoryId])
  @@index([materialId])
  @@index([room])
  @@index([stockStatus])
}

/// A record of stock added to the catalog — this business manufactures its
/// own furniture (no external suppliers), so this tracks internal
/// production batches coming into inventory, not purchase receipts.
/// `reference` is a free-text batch/production note, not a PO number.
model StockReceipt {
  id          String             @id @default(cuid())
  reference   String?
  note        String?            @db.Text
  receivedAt  DateTime           @default(now())
  createdBy   AdminUser?         @relation(fields: [createdById], references: [id])
  createdById String?
  items       StockReceiptItem[]
  createdAt   DateTime           @default(now())

  @@index([createdById])
  @@index([receivedAt])
}

model StockReceiptItem {
  id        String       @id @default(cuid())
  receipt   StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId String
  product   Product      @relation(fields: [productId], references: [id])
  productId String
  quantity  Int

  @@index([receiptId])
  @@index([productId])
}

enum ProductMediaType {
  IMAGE
  VIDEO_EMBED
  VIDEO_FILE
}

model ProductImage {
  id        String           @id @default(cuid())
  url       String
  alt       String?
  position  Int              @default(0)
  type      ProductMediaType @default(IMAGE)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime         @default(now())

  @@index([productId])
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?    @db.Text
  notes     String?    @db.Text
  status    LeadStatus @default(NEW)
  items     LeadItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
}

/// Simple key/value store for site-wide settings the admin can change
/// (active landing variant, WhatsApp number, etc.).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model LeadItem {
  id        String  @id @default(cuid())
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@index([leadId])
  @@index([productId])
}

/// Issue / feature / change request raised from the public site. Persisted
/// locally so nothing is lost, then (best-effort) synced to a GitHub issue.
model IssueReport {
  id                String    @id @default(cuid())
  type              IssueType @default(BUG)
  title             String
  body              String    @db.Text
  reporterName      String?
  reporterEmail     String?
  pageUrl           String?
  githubIssueNumber Int?
  githubIssueUrl    String?
  syncError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([type])
  @@index([createdAt])
}

model Customer {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  phone        String?
  /// Null for customer records created from a guest order; they can set a
  /// password later to "claim" the account.
  passwordHash String?
  addresses    Address[]
  orders       Order[]
  resetTokens  PasswordResetToken[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

/// A single-use, expiring token for the customer "forgot password" flow.
/// Only a hash of the token is stored — the raw token exists only in the
/// emailed link, same principle as never storing a plaintext password.
model PasswordResetToken {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

model Address {
  id            String   @id @default(cuid())
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  area          String?
  postCode      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
}

/// Admin-defined delivery zones (e.g. "Inside Dhaka", "Outside Dhaka") —
/// each order is charged whichever zone's fee the customer selects at
/// checkout. A fee of 0 is how a zone offers free shipping.
model ShippingZone {
  id        String   @id @default(cuid())
  name      String   @unique
  fee       Decimal  @default(0) @db.Decimal(10, 2)
  /// Pre-selected at checkout; exactly one zone should be default at a time
  /// (enforced in the admin action, not the DB).
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A placed order. Shipping details are denormalized (ship*) so later
/// address edits never rewrite order history.
model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerId     String?
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  shipName       String
  shipPhone      String
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipArea       String?
  shipPostCode   String?
  shippingZone   ShippingZone? @relation(fields: [shippingZoneId], references: [id])
  /// Nullable: orders placed before shipping zones existed have none.
  shippingZoneId String?
  items          OrderItem[]
  payments       Payment[]
  subtotal       Decimal       @db.Decimal(10, 2)
  shippingFee    Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("BDT")
  status         OrderStatus   @default(PLACED)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([shippingZoneId])
}

/// Snapshot of a product's name/price at order time, so later catalog
/// edits never alter past orders.
model OrderItem {
  id            String  @id @default(cuid())
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  product       Product @relation(fields: [productId], references: [id])
  productId     String
  nameSnapshot  String
  priceSnapshot Decimal @db.Decimal(10, 2)
  qty           Int
  lineTotal     Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id           String        @id @default(cuid())
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  gateway      PaymentMethod
  gatewayTxnId String?
  valId        String?
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  rawPayload   Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orderId])
  @@index([gatewayTxnId])
}
